{
  "name": "librarian",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc",
    "test": "npm run test:unit && npm run test:api && npm run build && npm run test:browser",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:api": "node --import tsx --test --test-concurrency=1 test/api/*.test.ts",
    "test:browser": "node --import tsx --test --test-concurrency=1 test/browser/*.test.ts",
    "test:live": "node --import tsx --test --test-concurrency=1 --test-timeout=600000 test/live/*.test.ts"
  },
  "author": "DA`/50 (https://github.com/day50-dev)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@hono/node-server": "^2.1.11",
    "@mozilla/readability": "^0.6.0",
    "agent-web-search": "^0.2.0",
    "better-auth": "^1.7.27",
    "better-sqlite3": "^13.2.0",
    "fast-xml-parser": "^5.12.1",
    "hono": "^4.13.19",
    "katex": "^0.19.1",
    "keenable": "^0.1.4",
    "linkedom": "^0.18.15",
    "ol": "^10.11.0",
    "pdfjs-dist": "^6.5.438",
    "prismjs": "^1.30.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "description": "A research librarian with unlimited time: drop a screenshot of hard material, box what stopped you, and get explanations that descend toward what you know instead of climbing into jargon."
}
